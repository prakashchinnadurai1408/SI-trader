# Reference only. Generate real values with scripts/hosting_secrets.py outside Git.
SI_TRADER_MODE=hosted
SI_TRADER_PUBLIC_ORIGIN=https://trader.example.com
SI_TRADER_AUTH_USER=operator@example.com
SI_TRADER_AUTH_PASSWORD_HASH=GENERATE_WITH_HOSTING_SECRETS_SCRIPT
SI_TRADER_ENCRYPTION_KEY=GENERATE_WITH_HOSTING_SECRETS_SCRIPT
SI_TRADER_DATA_DIR=/data
# Point to a prepared, validated bundle on the persistent volume when available.
# SI_TRADER_STRATEGY_BUNDLE=/data/bundles/monthly
# Optional private Ollama service; 127.0.0.1 means the deployment container itself.
# SI_TRADER_OLLAMA_URL=http://ollama:11434
